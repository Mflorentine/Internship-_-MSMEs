# Copy this file to .streamlit/secrets.toml for local development, and NEVER commit
# the real secrets.toml to GitHub (add it to .gitignore).
#
# On Streamlit Community Cloud, do not upload a secrets.toml file at all -- instead,
# paste this same TOML content into your app's Settings -> Secrets panel in the
# Streamlit Cloud dashboard. Streamlit Cloud stores it securely and injects it as
# st.secrets at runtime, so it is never part of your GitHub repository.
#
# IMPORTANT: keep at least one Admin account defined here. Streamlit secrets cannot
# be edited from inside the running app, so this is the only account guaranteed to
# exist after every fresh deploy -- it's what lets you log in and create everyone
# else (including additional Admins) from the in-app Admin panel.
#
# Generate a bcrypt hash for a new password with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password-here', bcrypt.gensalt()).decode())"

[users.admin1]
password_hash = "REPLACE_WITH_BCRYPT_HASH"
role = "Admin"
name = "System Administrator"

[users.clinician1]
password_hash = "REPLACE_WITH_BCRYPT_HASH"
role = "Clinician"
name = "Nurse A. Uwase"

[users.clinician2]
password_hash = "REPLACE_WITH_BCRYPT_HASH"
role = "Clinician"
name = "Nurse B. Mugisha"

[users.doctor1]
password_hash = "REPLACE_WITH_BCRYPT_HASH"
role = "Doctor"
name = "Dr. C. Habimana"
